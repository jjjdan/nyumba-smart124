# ============================================================
# NYUMBA SMART BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values
# ============================================================

NODE_ENV=development
PORT=3001

# ---- PostgreSQL Database ----
DATABASE_URL=postgresql://nyumba_user:your_password@localhost:5432/nyumba_smart
DB_SSL=false

# ---- JWT Auth ----
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=30d

# ---- MTN Mobile Money Uganda (Sandbox → Production) ----
# Get credentials from: https://momodeveloper.mtn.com
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_PRIMARY_KEY=your_mtn_collection_subscription_key
MTN_MOMO_COLLECTION_API_USER=your_api_user_uuid
MTN_MOMO_COLLECTION_API_KEY=your_api_key
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/payments/mtn/callback

# ---- Airtel Money Uganda ----
# Get credentials from: https://developers.airtel.africa
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret
AIRTEL_MONEY_CALLBACK_URL=https://your-domain.com/api/payments/airtel/callback

# ---- Africa's Talking SMS (Uganda) ----
# Get credentials from: https://africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=NYUMBA
AT_SMS_RATE_UGX=150

# ---- Redis (optional, for sessions / rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- App Config ----
FRONTEND_URL=http://localhost:5173
ADMIN_BOOTSTRAP_EMAIL=admin@nyumbasmart.co.ug
ADMIN_BOOTSTRAP_PASSWORD=change_this_immediately
