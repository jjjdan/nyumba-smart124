# ============================================================
# NYUMBA SMART BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real values
# ============================================================

NODE_ENV=development
PORT=3001

# ---- PostgreSQL Database ----
DATABASE_URL=postgresql://nyumba_user:your_password@localhost:5432/nyumba_smart
DB_SSL=false

# ---- JWT Auth ----
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=30d

# ---- Encryption (for landlord Paystack secrets at rest) ----
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32

# ---- Paystack (landlord-owned keys for rent; platform key for subscription fees) ----
# Rent: each landlord pastes their own Secret Key in-app (encrypted in DB).
# Platform fees (subscription / SMS billing) use this key:
PAYSTACK_PLATFORM_SECRET_KEY=sk_test_your_platform_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://your-domain.com/payments/callback
PUBLIC_API_URL=https://your-domain.com

# ---- Africa's Talking SMS (Uganda) ----
# Get credentials from: https://africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=NYUMBA
AT_SMS_RATE_UGX=150

# ---- Redis (optional, for sessions / rate limiting) ----
REDIS_URL=redis://localhost:6379

# ---- App Config ----
FRONTEND_URL=http://localhost:5173
ADMIN_BOOTSTRAP_EMAIL=admin@nyumbasmart.co.ug
ADMIN_BOOTSTRAP_PASSWORD=change_this_immediately
